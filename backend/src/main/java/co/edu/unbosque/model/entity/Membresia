import java.time.LocalDate;
import java.util.Objects;

public class Membresia {


    private String idMembresia; // PK
    private String plan;
    private String estado;
    private LocalDate fechaInicio;
    private LocalDate fechaFin;
    private String documento; // FK
    private double tarifa;

    public Membresia() {
    }

    public Membresia(String idMembresia, String plan, String estado, LocalDate fechaInicio,
                     LocalDate fechaFin, String documento, double tarifa) {
        this.idMembresia = idMembresia;
        this.plan = plan;
        this.estado = estado;
        this.fechaInicio = fechaInicio;
        this.fechaFin = fechaFin;
        this.documento = documento;
        this.tarifa = tarifa;
    }

    public String getIdMembresia() {
        return idMembresia;
    }

    public void setIdMembresia(String idMembresia) {
        this.idMembresia = idMembresia;
    }

    public String getPlan() {
        return plan;
    }

    public void setPlan(String plan) {
        this.plan = plan;
    }

    public String getEstado() {
        return estado;
    }

    public void setEstado(String estado) {
        this.estado = estado;
    }

    public LocalDate getFechaInicio() {
        return fechaInicio;
    }

    public void setFechaInicio(LocalDate fechaInicio) {
        this.fechaInicio = fechaInicio;
    }

    public LocalDate getFechaFin() {
        return fechaFin;
    }

    public void setFechaFin(LocalDate fechaFin) {
        this.fechaFin = fechaFin;
    }

    public String getDocumento() {
        return documento;
    }

    public void setDocumento(String documento) {
        this.documento = documento;
    }

    public double getTarifa() {
        return tarifa;
    }

    public void setTarifa(double tarifa) {
        this.tarifa = tarifa;
    }

    // La igualdad se basa en la llave primaria (idMembresia)
    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        Membresia that = (Membresia) o;
        return Objects.equals(idMembresia, that.idMembresia);
    }

    @Override
    public int hashCode() {
        return Objects.hash(idMembresia);
    }

    @Override
    public String toString() {
        return "Membresia{" +
                "idMembresia='" + idMembresia + '\'' +
                ", plan='" + plan + '\'' +
                ", estado='" + estado + '\'' +
                ", fechaInicio=" + fechaInicio +
                ", fechaFin=" + fechaFin +
                ", documento='" + documento + '\'' +
                ", tarifa=" + tarifa +
                '}';
    }
}